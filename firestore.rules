rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile Validation
    function isValidUser(data) {
      return data.uid is string && 
             data.username is string && 
             data.username.size() <= 128 &&
             data.theme in ['dark', 'light'] &&
             data.savedIds is list &&
             data.forkedIds is list &&
             data.favoritesIds is list &&
             data.isAdmin is bool;
    }

    // Users Collection Rules
    match /users/{userId} {
      // Allow read if owner
      allow get: if isOwner(userId);
      
      // Allow list only if owner (prevents scraping)
      allow list: if isOwner(userId);

      // Allow creation of own profile
      allow create: if isOwner(userId);

      // Allow updates to own profile
      allow update: if isOwner(userId) && 
                    isValidUser(request.resource.data) && 
                    request.resource.data.uid == resource.data.uid &&
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAdmin']) == false || isAdmin());
    }
    
    // Admin check logic
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rockyzyar@gmail.com' || 
        request.auth.token.email == 'shauryabis672@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }
  }
}
